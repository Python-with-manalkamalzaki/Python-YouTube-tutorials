#code 4
class My_tuple:
    def __init__(self, x, y):
        self.x = x
        self.y = y
    def __add__(self, other):      # magic method
        return My_tuple(self.x + other.x, self.y + other.y)
    def __sub__(self, other):      # magic method
        return My_tuple(self.x - other.x, self.y - other.y)
    def __mul__(self, other):      # magic method
        return My_tuple(self.x * other.x, self.y * other.y)
    def __eq__(self, other):      # magic method
        return My_tuple(self.x == other.x, self.y == other.y)
    def __gt__(self, other):      # magic method
        return My_tuple(self.x > other.x, self.y > other.y)
    def __repr__(self):   # displays the output of the desired magic method
        return f"the result is: ({self.x}, {self.y})"
my_tuple_1 = My_tuple(10, 5)
my_tuple_2 = My_tuple (2, 3)

z1 = my_tuple_1 + my_tuple_2 # variable = instance 1 + instance 2
print("+", z1) # activated by the __repr__ , otherwise the location of z will be printed

z2 = my_tuple_1 - my_tuple_2
print("-", z2)
z3 = my_tuple_1 * my_tuple_2
print("*", z3)
z4 = my_tuple_1 == my_tuple_2
print("==", z4)
z5 = my_tuple_1 > my_tuple_2
print(">", z5)

