#code 2
class My_tuple:
    def __init__(self, x, y):
        self.x = x
        self.y = y

    def __getitem__(self, index): #__getitem__ retrieves the value of the items from the instance
        if index == 0:
            return self.x  #assigns the value of the first index of an instance to x
        else:
            return self.y  #assigns the value of the second index of an instance to y

    def __repr__(self):  # use __repr__ to display output
        return f"The result is ({self.x}, {self.y})"

my_tuple_1 = My_tuple(10.5, 5.6)
print(my_tuple_1)    #prints the first tuple

