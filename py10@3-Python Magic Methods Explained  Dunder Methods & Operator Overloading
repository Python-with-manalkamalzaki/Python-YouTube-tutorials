        return My_tuple(self.x + other.x, self.y + other.y)

    def __repr__(self):   # displays the output of the desired magic method
        return f"the result is: ({self.x}, {self.y})"

def main():
    my_tuple_1 = My_tuple(10, 5)
    my_tuple_2 = My_tuple (2, 3)

    z1 = my_tuple_1 + my_tuple_2
    print(z1)

if __name__ == "__main__":
