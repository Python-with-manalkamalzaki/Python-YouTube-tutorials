#code 1
# getters and setters -- Accessors and mutators
# getters are methods to (get the value of an attribute)
# setters are methods to (set the value of an attribute)
# 1st approach: use built in methods of getters and setters---- getattr and setattr----
# getattr is a method to get the object by an attribute--(get the value of an attribute)
# setattr is a method to set an object by 3 attributes which are (object, first attribute, new attribute)--(set the value of an attribute)
# setattr is a method to delete an object--(delete an attribute)
# we use dot notation --eg.-- x.std.reg   then    std.reg="aa_01"
class Bank_Client:
    def __init__(self, name, local_deposit, dollar_deposit):
        self.name=name
        self.local_deposit=local_deposit
        self.dollar_deposit=dollar_deposit

#  main Program  #
client_1=Bank_Client("manal", 1000, 200)
client_2=Bank_Client("manal", 1000, 200)

#print(client_2)       # does not give expected data
