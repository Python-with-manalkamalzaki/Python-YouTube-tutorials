#3rd approach: code 1
#use property decorator -- @property
class Bank_Client:
    def __init__(self, name, local_deposit, dollar_deposit):
        self.name=name
        self.local_deposit=local_deposit
        self.dollar_deposit=dollar_deposit

    @property
    def fulldata(self):
        return f"client name is: {self.name} local_deposite={self.local_deposit} dollar_deposit={self.dollar_deposit}"

    @property
    def name(self):         # we decorate this method with a property decorator in order to be a getter method
        #return self._name
        return f"client name is: {self._name}"  # _ means internal, we cannot access this attribute outside the class
    @name.setter
    def name(self, newname):
        self._name=newname                     # _ means internal, we cannot access this attribute outside the class

#  main Program  #
client1=Bank_Client("manal", 1000, 200)
client2=Bank_Client("Sandy", 1000, 200)

print (client2.name)                         # we did not use _    ie to be used only inside the class
print (client2.fulldata)
client2.newname="sue"
print (client2.newname)

# 3rd approach: code 2
#use property decorator -- @property
class Bank_Client: # accepts only two arguments in the init function
    def __init__(self, name, local_deposit):
        self.name=name
        self.local_deposit=local_deposit

    @property
    def fulldata(self):
        return f"client name is: {self.name} local_deposit={self.local_deposit} "

    @property
    def name(self):         # we decorate this method with a property decorator in order to be a getter method
        #return self._name
        return f"client name is: {self._name}"  # _ means internal, we cannot access this attribute outside the class
    @name.setter
    def name(self, newname):
        self._name=newname                     # _ means internal, we cannot access this attribute outside the class

    @property
    def local_deposit(self):  # we decorate this method with a property decorator in order to be a getter method
        # return self.local_deposit
        return f"client local_deposit is: {self._local_deposit}"  # _ means internal, we cannot access this attribute outside the class

    @local_deposit.setter
    def local_deposit(self, newlocal_deposit):
        self._local_deposit = newlocal_deposit  # _ means internal, we cannot access this attribute outside the class

    @name.deleter
    def name(self):
        del self._name
        print("name is deleted")

    @local_deposit.deleter                         # must have a getter and a setter to be deleted
    def local_deposit(self):
        del self._local_deposit
        print("local_deposit is deleted")

     # main Program
client1=Bank_Client("manal", 1000)
client2=Bank_Client("Sandy", 1000)

print (client2.name)                         # we did not use _    ie to be used only inside the class
print (client2.fulldata)
client2.newname="sue"
client2.newlocal_deposit=6000
del client2.name
del client2.local_deposit
print (client2.newname)
print(client2.newlocal_deposit)

